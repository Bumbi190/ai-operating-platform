export const CONTRACT_VERSION: 1;
export type Task = {kind:'classify';text:string;labels:string[]} | {kind:'extract';text:string} | {kind:'summarize';text:string};
export type TaskResult = {label:string} | {company:string|null;city:string|null;registrationNumber:string|null} | {bullets:string[]};
export type RequestLocalText = {projectId:string;conversationId:string;idempotencyKey:string;task:Task};
export type JobState = 'queued'|'claimed'|'running'|'reviewing'|'escalation_pending'|'needs_input'|'succeeded'|'failed'|'cancelled'|'reconciling';
export const JOB_STATES: readonly JobState[];
export type JobReceipt = {id:string;projectId:string;conversationId:string;state:JobState;reasonCode:string|null;result:TaskResult|null;reviewStatus:'pending'|'approved'|'rejected'|'unknown';selectionId:string|null;expiresAt:string;updatedAt:string};
export type VerifiedContext = {userId:string;projectId:string;conversationId:string;dataClass:'synthetic'|'approved_cloud_text';placement:'cloud_control_review_allowed';policyVersion:string;admissionId:string;deadlineAt:string;jobCostCapUsd:number;dailyCostCapUsd:number};
export type SelectionDecision = {id:string;jobId:string;inputHash:string;projectId:string;profile:'local_assist_v1';policyVersion:string;candidateId:string;modelDigest:string;deploymentId:string;admissionId:string;evidenceHash:string;healthAt:string;validUntil:string;exclusions:Record<string,string[]>;totalExpectedCostUsd:number|null;costUncertainty:string[];fallback:'governed_openai'|'human'|'none'};
export type Claim = {jobId:string;attemptId:string;deviceId:string;claimId:string;fence:number;inputHash:string;selectionId:string;modelDigest:string;leaseUntil:string;expiresAt:string;task:Task};
export type ReviewReceipt = {jobId:string;attemptId:string;inputHash:string;resultHash:string;reviewRunId:string;reviewAttemptId:string;reviewerDeployment:string;status:'approved'|'rejected'|'unknown';reasonCodes:string[];usageRef:string|null;createdAt:string};
export type TransitionResult<T> = {kind:'applied';value:T}|{kind:'duplicate';value:T}|{kind:'refused';reason:string}|{kind:'unknown';reconcileId:string};
export type WorkerOperation = 'enroll'|'heartbeat'|'claim'|'started'|'complete'|'fail'|'reconcile';
export const WORKER_OPERATIONS: readonly WorkerOperation[];
export type WorkerEnvelope = {version:1;origin:string;deviceId:string;buildHash:string;keyId:string;counter:string;nonce:string;issuedAt:string;expiresAt:string;method:'POST';path:string;bodySha256:string;signature:string};
export type UnsignedWorkerEnvelope = Omit<WorkerEnvelope,'signature'>;
export function isUuid(value:unknown):value is string;
export function isSha256(value:unknown):value is string;
export function parseTask(value:unknown):Task;
export function parseRequest(value:unknown):RequestLocalText;
export function parseClaim(value:unknown):Claim;
export function parseWorkerEnvelope(value:unknown):WorkerEnvelope;
export function validateTaskResult(task:Task,value:unknown):TaskResult;
export function canonicalJson(value:unknown):string;
export function sha256(bytes:string|Uint8Array):string;
export function hashTask(task:Task):string;
export function toPilotJob(task:Task,jobId:string):{version:1;jobId:string;taskType:Task['kind'];text:string;labels?:string[]};
export function workerSigningPayload(input:UnsignedWorkerEnvelope):Uint8Array;
